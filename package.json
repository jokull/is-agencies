{
  "name": "is-agencies",
  "description": "Community maintained site of Icelandic web agencies",
  "license": "MIT",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler pages deploy dist/",
    "lint": "oxlint -c .config/.oxlintrc.json --deny-warnings --report-unused-disable-directives",
    "fmt": "oxfmt -c .config/.oxfmtrc.json",
    "fmt:check": "oxfmt -c .config/.oxfmtrc.json --check"
  },
  "dependencies": {
    "astro": "^5.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.1",
    "oxfmt": "0.36.0",
    "oxlint": "1.51.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "wrangler": "4.70.0"
  }
}
